# Buchungs-UI Provider: easyrent | rentbuddy | demo
VITE_BOOKING_PROVIDER=easyrent

# Vite public base (GitHub Pages project path)
# VITE_BASE=/tischbuch/rentfreudenhaus/

# Easyrent-API (EasyRest) — NUR serverseitig / Smoke-Script (nie VITE_ Prefix!)
# HTTP :11122 absichtlich nicht nutzen — Script blockiert Klartext.
EASYREST_BASE_URL=https://89.26.17.53:11133/easyrest/rest/easyrest
EASYREST_ACCESS_ID=
# 1 = abgelaufenes/self-signed Zertifikat akzeptieren (Übergang)
EASYREST_TLS_INSECURE=1
# 1 = wirklich POST /reservation/insertupdatereservation (sonst Dry-Run)
EASYREST_LIVE_BOOK=0
